<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>WoW2.Backbone.Language.Core.Extensions.Enums.Category</Title>
        <PackageId>WoW2.Backbone.Language.Core.Extensions.Enums.Category</PackageId>
        <Description>Extension for enum categories with enhanced grouping and classification support.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>language, core, enums, extensions, category, enum-categories</PackageTags>
        <Version>9.0.0-alpha.2</Version>
        <Authors>WoW 2.0 Team</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/WoW-2-0-Backbone/Backbone.Language.Core</PackageProjectUrl>
        <RepositoryUrl>https://github.com/WoW-2-0-Backbone/Backbone.Language.Core</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>wow2.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Include="wow2.png" Pack="true" PackagePath=""/>
        <None Include="README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="WoW2.Backbone.Language.Core.Extensions.Enums.Correlation" Version="9.0.0-alpha.1" />
      <PackageReference Include="WoW2.Backbone.Language.Core.Extensions.Enums.Ranges" Version="9.0.0-alpha.2" />
    </ItemGroup>

</Project>